  "description": "B\u1ed9 test Catalog (Zone / Space / Package / Product) cho K\u00c9N K\u1ebft N\u1ed1i - node:test",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
