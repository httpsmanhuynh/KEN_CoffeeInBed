    "type": "commonjs",
    "main": "index.js",
    "scripts": {
        "start": "nodemon index.js",
        "test": "node --test test/*.test.js",
        "start:prod": "node index.js",
        "setup": "node -e \"require('dotenv').config();const{MongoClient}=require('mongodb');const{ensureIndexes}=require('./src/config/indexes');(async()=>{const c=new MongoClient(process.env.MONGODB_URI||'mongodb://127.0.0.1:27017');await c.connect();await ensureIndexes(c.db('ken_space_booking'));await c.close();console.log('Indexes OK')})().catch(e=>{console.error(e);process.exit(1)})\""
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "connect-mongo": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-fileupload": "^1.5.2",
        "express-session": "^1.19.0",
        "mongodb": "^7.7.0",
        "morgan": "^1.12.1"
    },
    "devDependencies": {
        "nodemon": "^3.1.14"
    }
}
